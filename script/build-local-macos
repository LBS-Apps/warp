#!/usr/bin/env bash
# Build WarpOss.app locally instead of on GitHub Actions.
#
# Why this exists: this fork's macOS CI build takes 68-103 minutes on a
# GitHub-hosted runner, and macOS runners bill at 10x, so a single build costs
# 680-1030 of a free account's 2000 monthly minute-equivalents. Six builds in
# July 2026 consumed 7030 and blocked Actions across every private repo on the
# account for three weeks. Building here costs nothing.
#
# Usage (runnable from any directory, by absolute path or relative):
#   script/build-local-macos            # release-lto build (slow, shippable)
#   script/build-local-macos --dev      # debug build (fast, for iterating)
#   ~/warp/script/build-local-macos     # from anywhere
#
# Refuses to start on battery: a full build pins every core for the better part
# of an hour, which drains a laptop battery faster than it can finish.

set -euo pipefail

# Resolve the repo from THIS SCRIPT's own location, not the caller's cwd.
# `git rev-parse --show-toplevel` reads $PWD, so invoking the script by absolute
# path from anywhere outside the repo died with "fatal: not a git repository"
# before it did anything at all.
REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$REPO_ROOT"

PROFILE="release"
EXTRA=""
# cargo-bundle writes under the CARGO PROFILE DIRECTORY, which is not the same
# string as the profile flag: --debug lands in `debug`, the default lands in
# `release-lto`. Track it so the bundle is located by construction below rather
# than by searching.
PROFILE_DIR="release-lto"
if [ "${1:-}" = "--dev" ]; then
  PROFILE="dev"
  EXTRA="--debug"
  PROFILE_DIR="debug"
fi

# --- power gate -------------------------------------------------------------
if ! pmset -g batt | grep -q "AC Power"; then
  PCT="$(pmset -g batt | grep -oE '[0-9]+%' | head -1)"
  echo "Refusing to build on battery power (currently ${PCT:-unknown})." >&2
  echo "A ${PROFILE} build pins all cores for up to an hour. Plug in and rerun." >&2
  exit 1
fi

# --- disk gate --------------------------------------------------------------
# A release-lto target/ for this workspace runs tens of GB.
FREE_GB="$(df -g "$REPO_ROOT" | awk 'NR==2 {print $4}')"
MIN_GB=40
if [ "$FREE_GB" -lt "$MIN_GB" ]; then
  echo "Only ${FREE_GB}GB free on this volume; a ${PROFILE} build needs ~${MIN_GB}GB." >&2
  echo "Free some space, or run: cargo clean" >&2
  exit 1
fi

# --- build deps -------------------------------------------------------------
# protoc: the workspace compiles .proto files via prost-build.
# create-dmg: script/macos/bundle calls it unconditionally; the bundle step
#             exits 127 without it, even though we only keep the .app.
for dep in protoc create-dmg; do
  command -v "$dep" >/dev/null || { echo "Missing $dep. Install: brew install protobuf create-dmg" >&2; exit 1; }
done
command -v cargo-bundle >/dev/null || ./script/install_cargo_bundle
cargo about --version >/dev/null 2>&1 || cargo install --locked cargo-about@0.8.4

# Metal shaders: warpui's build.rs compiles shaders.metal to .air, which needs the
# Metal Toolchain. GitHub's macos runner images ship it; a local Xcode does not, and
# the build gets most of the way through before failing on it. `xcrun -f metal` finds
# the driver binary even when the toolchain is absent, so probe by compiling.
if ! echo 'kernel void t() {}' | xcrun metal -x metal -c - -o /dev/null 2>/dev/null; then
  echo "Metal Toolchain missing - downloading (~690MB, one time)..."
  xcodebuild -downloadComponent MetalToolchain
fi

echo "Building ${PROFILE} bundle on AC power, ${FREE_GB}GB free..."
START=$(date +%s)

# caffeinate: a sleeping laptop mid-link wastes the whole build.
# The bundle script always finishes by building a .dmg via create-dmg, which fails
# on some macOS versions ("interstitial disk image was not found") long after the
# .app itself is built and signed. We ship the .app, so judge success by whether
# the bundle exists rather than by the script's exit code.
caffeinate -i ./script/bundle --selfsign --arch aarch64 -c oss $EXTRA || BUNDLE_RC=$?

# Scope the search to the profile we just built. A bare `find target ... | head -1`
# also matches stale bundles from OTHER profiles — a leftover
# target/debug/bundle/osx/WarpOss.app in particular — and find's traversal order is
# filesystem-dependent, not sorted. Picking the wrong one silently stamps
# BUILD_COMMIT into a stale debug bundle and prints an install command for it, so a
# `ditto` of "the build you just made" would put a debug app in /Applications.
APP="$(find target -type d -path "*/${PROFILE_DIR}/bundle/osx/*" -name '*.app' | head -1)"
if [ -z "$APP" ]; then
  echo "Build failed (bundle exit ${BUNDLE_RC:-0}) and produced no .app under target/**/bundle/osx" >&2
  exit 1
fi
if [ -n "${BUNDLE_RC:-}" ]; then
  echo "Note: bundle script exited ${BUNDLE_RC} (usually the .dmg step); the .app was produced."
  # create-dmg leaves its read/write image mounted when it fails partway.
  for dev in $(hdiutil info | awk '/rw\..*\.dmg/{found=1} found && /^\/dev\/disk[0-9]+\t/{print $1; exit}'); do
    hdiutil detach "$dev" -force >/dev/null 2>&1 || true
  done
  rm -f target/*/release-lto/bundle/osx/dmg/*/rw.*.dmg 2>/dev/null || true
fi

# Stamp provenance into the bundle. The auto-updater compares this against the
# commit behind the newest CI artifact so it can pick the newer of the two and,
# more importantly, never replace a local build with an older CI one.
git rev-parse HEAD > "$APP/Contents/Resources/BUILD_COMMIT"

# --- pin the bundle to a stable code-signing identity ------------------------
# Two things force this to happen HERE, in the build directory, and not only in
# ~/bin/warposs-install.sh when the app lands in /Applications:
#
# 1. `script/bundle --selfsign` looks for an identity whose name contains
#    "Apple Development" and falls back to AD-HOC signing when it finds none.
#    There is no such identity on this machine, so every local build is ad-hoc:
#    its designated requirement is a bare `cdhash H"..."`, which changes with
#    every single build.
# 2. macOS keys TCC grants and keychain ACLs on the BUNDLE ID plus that
#    requirement, and this bundle id (dev.warp.WarpOss) is shared by the copy in
#    /Applications and every copy left under target/. Launching the ad-hoc
#    build-dir copy — a restart restoring it by path is enough — rewrites the
#    stored requirement to that build's cdhash, so the next launch of the
#    properly signed /Applications copy no longer matches and macOS re-prompts
#    for the login keychain password plus Desktop / Documents / Downloads /
#    Apple Music / app-data access. Verified 19.08.2026 in tccd's log:
#      Failed to match existing code requirement for subject dev.warp.WarpOss
#    Signing both copies with one fixed certificate keeps the requirement
#    identical no matter which copy is launched, so the grants stick.
#
# The entitlements MUST be passed again: codesign --force replaces the whole
# signature, and re-signing without them silently drops every entitlement the
# bundle step applied. tccd then logs, for the stripped bundle:
#   service: kTCCServiceAppleEvents requires entitlement
#   com.apple.security.automation.apple-events but it is missing
#
# Signing comes after the BUILD_COMMIT stamp on purpose: Contents/Resources is
# sealed, so writing that file invalidates whatever signature was already there.
SIGN_ID="WarpOss Local Signing"
ENTITLEMENTS="$REPO_ROOT/script/Debug-Entitlements.plist"

# Read the identity list into a variable instead of piping it into `grep -q`:
# under `set -o pipefail` grep exits on the first match, `security` dies of
# SIGPIPE, and the pipeline reports 141 — a successful match would read as
# "identity missing".
IDENTITIES="$(security find-identity -p codesigning 2>/dev/null || true)"
EXPECTED_LEAF="$(printf '%s\n' "$IDENTITIES" | awk -v id="$SIGN_ID" '$0 ~ id { print $2; exit }')"

case "$IDENTITIES" in
  *"$SIGN_ID"*)
    if codesign --force --deep --options runtime --sign "$SIGN_ID" \
         --entitlements "$ENTITLEMENTS" "$APP"; then
      echo "Signed with '$SIGN_ID'."
    else
      echo "WARNING: signing with '$SIGN_ID' failed; the bundle stays ad-hoc." >&2
    fi
    ;;
  *)
    echo "WARNING: identity '$SIGN_ID' is not in the keychain; the bundle stays" >&2
    echo "ad-hoc, so macOS will re-prompt for permissions after every build." >&2
    ;;
esac

# Check the result on disk rather than trusting the exit code above: an ad-hoc
# fallback is exactly what brings the permission prompts back, and it would
# otherwise only print a line nobody reads. An ad-hoc signature prints its
# requirement commented out ("# designated => ..."), so strip the prefix and
# report what was found instead.
DR="$(codesign -d -r- "$APP" 2>&1 | sed -n 's/^#* *designated => //p' || true)"
if [ -n "$EXPECTED_LEAF" ] && printf '%s' "$DR" | grep -qi "$EXPECTED_LEAF"; then
  echo "Designated requirement pinned to '$SIGN_ID' (${EXPECTED_LEAF:0:8})."
else
  echo "WARNING: bundle is NOT pinned to '$SIGN_ID'." >&2
  echo "  designated requirement: ${DR:-<none>}" >&2
  echo "  expected certificate leaf: ${EXPECTED_LEAF:-<identity not in keychain>}" >&2
  echo "  macOS will treat this build as a new app and re-prompt for the keychain" >&2
  echo "  password and for Desktop / Documents / Downloads access." >&2
fi

MINS=$(( ($(date +%s) - START) / 60 ))
echo
echo "Built in ${MINS}m: $APP"
echo "Install it with:  ditto \"$APP\" /Applications/\$(basename \"$APP\")"
